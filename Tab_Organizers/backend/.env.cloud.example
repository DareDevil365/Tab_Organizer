# Local cloud testing only: TAB_ORGANIZER_PROFILE=cloud python -m app.main
# Keep .env.cloud private. Configure these values in Vercel for deployment.
APP_MODE=cloud
DATABASE_URL=
EMBEDDING_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
SUPABASE_URL=
# Generated private connection key: saved once in the extension, no login screen.
BACKEND_API_KEY=
CLASSIFY_ON_STARTUP=false
# Existing GEMINI_API_KEY can remain in the private local .env file.
# Vercel needs GEMINI_API_KEY in its server environment variables.
CRON_SECRET=
