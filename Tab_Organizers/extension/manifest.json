{
  "manifest_version": 3,
  "minimum_chrome_version": "127",
  "name": "Tab Organizer",
  "version": "0.1.0",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "unlimitedStorage",
    "notifications",
    "alarms",
    "scripting",
    "activeTab",
    "contextMenus",
    "downloads",
    "idle"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "public/icons/icon16.png",
      "48": "public/icons/icon48.png",
      "128": "public/icons/icon128.png"
    }
  },
  "icons": {
    "16": "public/icons/icon16.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "options_page": "src/dashboard/dashboard.html",
  "web_accessible_resources": [{
    "resources": ["src/popup/popup.html", "assets/*", "public/icons/icon16.png", "public/icons/icon48.png", "public/icons/icon128.png"],
    "matches": ["http://*/*", "https://*/*"]
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
